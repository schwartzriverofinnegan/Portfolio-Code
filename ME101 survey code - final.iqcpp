{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\nmotor leftMotor = motor(PORT1, true);\nmotor rightMotor = motor(PORT6, false);\nbumper Bumper12 = bumper(PORT12);\ndistance Distance7 = distance(PORT7);\ntouchled TouchLED9 = touchled(PORT9);\noptical Optical3 = optical(PORT3);\nmotor backMotor = motor(PORT4, true);\nmotor pinionMotor = motor(PORT5, false);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n// Converts a color to a string\nconst char* convertColorToString(color col) {\n  if (col == colorType::red) return \"red\";\n  else if (col == colorType::green) return \"green\";\n  else if (col == colorType::blue) return \"blue\";\n  else if (col == colorType::white) return \"white\";\n  else if (col == colorType::yellow) return \"yellow\";\n  else if (col == colorType::orange) return \"orange\";\n  else if (col == colorType::purple) return \"purple\";\n  else if (col == colorType::cyan) return \"cyan\";\n  else if (col == colorType::black) return \"black\";\n  else if (col == colorType::transparent) return \"transparent\";\n  else if (col == colorType::red_violet) return \"red_violet\";\n  else if (col == colorType::violet) return \"violet\";\n  else if (col == colorType::blue_violet) return \"blue_violet\";\n  else if (col == colorType::blue_green) return \"blue_green\";\n  else if (col == colorType::yellow_green) return \"yellow_green\";\n  else if (col == colorType::yellow_orange) return \"yellow_orange\";\n  else if (col == colorType::red_orange) return \"red_orange\";\n  else if (col == colorType::none) return \"none\";\n  else return \"unknown\";\n}\n\n\n// Convert colorType to string\nconst char* convertColorToString(colorType col) {\n  if (col == colorType::red) return \"red\";\n  else if (col == colorType::green) return \"green\";\n  else if (col == colorType::blue) return \"blue\";\n  else if (col == colorType::white) return \"white\";\n  else if (col == colorType::yellow) return \"yellow\";\n  else if (col == colorType::orange) return \"orange\";\n  else if (col == colorType::purple) return \"purple\";\n  else if (col == colorType::cyan) return \"cyan\";\n  else if (col == colorType::black) return \"black\";\n  else if (col == colorType::transparent) return \"transparent\";\n  else if (col == colorType::red_violet) return \"red_violet\";\n  else if (col == colorType::violet) return \"violet\";\n  else if (col == colorType::blue_violet) return \"blue_violet\";\n  else if (col == colorType::blue_green) return \"blue_green\";\n  else if (col == colorType::yellow_green) return \"yellow_green\";\n  else if (col == colorType::yellow_orange) return \"yellow_orange\";\n  else if (col == colorType::red_orange) return \"red_orange\";\n  else if (col == colorType::none) return \"none\";\n  else return \"unknown\";\n}\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n//----------------------------------------------------------------------------\n//\n//    Module:       main.cpp\n//    Author:       {author}\n//    Created:      {date}\n//    Description:  IQ project - automated scantron grader\n//\n//----------------------------------------------------------------------------\n\n// Include the IQ Library\n#include \"iq_cpp.h\"\n\n\nconst int PAGE_DIST = 1; // mm, distance to paper from sensor\nconst int QUESTIONS = 10; // max questions per test\nconst int MAX_STUDENTS = 10; // max students per grading run\nconst double PINION_DIAMETER = 20.0; // mm, rack-and-pinion diameter - verify this\nconst int TOTAL_ANSWERS = QUESTIONS * 5;\nconst int MAX_DIST = 125; //mm, max distance the pinion can travel\n\n\nmotor_group intakeMotors(leftMotor, rightMotor);\nmotor_group allMotors(leftMotor, rightMotor, backMotor); //useful for when all motors need to turn off\n\n\n// Returns true if any drive motor is drawing more current than expected\nbool motorCurrent() {\n  if (leftMotor.current(amp) > 1 || rightMotor.current(amp) > 1 ||\n      backMotor.current(amp) > 1) {\n    return true;\n  } else {\n    return false;\n  }\n  // test cases: run the motor for a few minutes and check for auto-stop/heat\n  // jam the wheels and confirm this returns true\n}\n\n\n// Checks the distance sensor and spins the back (eject) wheel while a sheet is detected in front of it.\nvoid outputWheel() {\n  backMotor.spin(forward, 50, percent); \n  while (Distance7.objectDistance(mm) < PAGE_DIST && !motorCurrent())\n  {}\n  backMotor.stop(brake);\n  // test cases: paper on sensor -> motor off, paper off sensor -> motor on\n}\n\n\n// A substitute \"spin for\" function that waits to see the next red block, stopped by the left button\nvoid walmartSpinFor(double distance)\n{\n  intakeMotors.spin(forward,10,percent);\n  while (Optical3.color() == red && !Brain.buttonLeft.pressing() && !motorCurrent());\n  {}\n  while(Optical3.color() != red && !Brain.buttonLeft.pressing() && !motorCurrent())\n  {}\n  intakeMotors.stop(brake);\n}\n\n\n// Same as the previous function except it's for the back motor,\n//this is used for the last question on the sheet since the intake motors can't reach the paper anymore\nvoid walmartSpinForBack(double distance)\n{\n  backMotor.spin(forward,20,percent); //speed is higher than for intake because back wheel doesn't grip paper very well\n  while (Optical3.color() == red && !Brain.buttonLeft.pressing() && !motorCurrent())\n  {}\n  while(Optical3.color() != red && !Brain.buttonLeft.pressing() && !motorCurrent())\n  {}\n  backMotor.stop(brake);\n}\n\n\n// intakes paper to red square and then moves rack and pinion; reads the rack travel distance and converts it into a lettered answer (A-D)\nchar scanAnswers()\n{\n  pinionMotor.resetPosition(); //this is done so the pinion can be moved back to the exact origin after it's done scanning\n  pinionMotor.spin(forward, 15, percent);\n\n  while (Optical3.color() != green && (pinionMotor.position(degrees) / 360) * M_PI * PINION_DIAMETER < MAX_DIST && !Brain.buttonLeft.pressing() && !motorCurrent())\n  {} //wait until sensor sees green or the pinion has gone the max distance\n\n  pinionMotor.stop(brake);\n\n\n    double motorDegrees = pinionMotor.position(degrees);\n    double rackDistance = (motorDegrees / 360.0) * M_PI * PINION_DIAMETER;\n\n    char answer;\n\n    if (rackDistance < 50) // mm; hard-coded distances for each of the bubbles\n        answer = 'A';\n  \n    else if (rackDistance < 80)\n        answer = 'B';\n        \n    else if (rackDistance < 115)\n        answer = 'C';\n        \n    else\n        answer = 'D';\n        \n\n    // Return the pinion to the starting position\n    pinionMotor.spin(reverse, 10, percent);\n\n    while (pinionMotor.position(degrees) > 2 && !Brain.buttonLeft.pressing() && !motorCurrent()) //tolerance because i dont want it to overshoot to 0\n    {\n    }\n\n    pinionMotor.stop(brake);\n\n    return answer;\n}\n\n\n//this code doesn't contain the answerKey function since there are no\n//answer keys for surverys, this is also the reason it doesn't contain\n//the gradeAnswer function\n\n\n// Function that sort of puts it all together, waits for LED and bumper pressed and then starts the\n// scanning and grading code using the previous functions\nint testInput(int stats[], bool &failure) {\n  Brain.Screen.clearScreen(); //user interaction\n  Brain.Screen.setFont(mono15);\n  Brain.Screen.print(\"Input one test\");\n  Brain.Screen.newLine();\n  Brain.Screen.print(\"and press LED\"); \n\n  int numberOfTests = 0;\n  int tempIndex = 0;\n\n  while (!Brain.buttonLeft.pressing() && !motorCurrent() && numberOfTests < MAX_STUDENTS) { //this loops for every test\n    backMotor.stop(brake);\n    while (!Bumper12.pressing()) //wait for tray to be placed\n    {}\n    TouchLED9.setColor(blue);\n    while (!TouchLED9.pressing())  // wait for start press\n    {}\n    while (TouchLED9.pressing())   // wait for release\n    {}\n    TouchLED9.off(); //touchLED turns off after tapped\n    printf(\"Processing student %d\\n\", numberOfTests+1);\n\n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1,1);\n    Brain.Screen.print(\"Processing test.\");\n    Brain.Screen.newLine();\n    Brain.Screen.print(\"Press left button\");\n    Brain.Screen.newLine();\n    Brain.Screen.print(\"for E-stop.\");\n\n\n    int index = 0;\n    while (index < QUESTIONS && !Brain.buttonLeft.pressing() && !motorCurrent()) //this loops for every row\n    {\n      if (Distance7.objectDistance(mm) > PAGE_DIST && index > QUESTIONS-1) { //if the last question is scanned, this makes sure that it get out of the loop\n        index += 20;\n      }\n      else if (index >= QUESTIONS-2) { //if its on the last question, use the back wheel to intake\n        char letter = scanAnswers(); \n\n        //every four spots in the array represent one question\n        if (letter == 'A')\n          tempIndex = index * 4; //the first spot is the letter A\n\n        else if (letter == 'B')\n          tempIndex = (index * 4) +1; //The second the letter B\n\n        else if (letter == 'C')\n          tempIndex = (index*4)+2; //and so on\n        \n        else\n          tempIndex = (index*4) + 3; //and so on\n        \n        stats[tempIndex] +=1; //add a count to that place in the array\n\n        index++;\n      }\n      else{ //else use the intake motors to intake\n        intakeMotors.spin(forward,7,percent);\n        while (Optical3.color() != red && !Brain.buttonLeft.pressing())\n        {}\n        intakeMotors.stop(brake);\n\n        char letter = scanAnswers(); \n\n        if (letter == 'A')\n          tempIndex = index * 4;\n\n        else if (letter == 'B')\n          tempIndex = (index * 4)+1;\n\n        else if (letter == 'C')\n          tempIndex = (index*4) + 2;\n          \n        else\n          tempIndex = (index*4) + 3;\n          \n        stats[tempIndex]++;\n\n        walmartSpinFor(10); //waits for next red block\n        index++;\n      }\n    }\n\n    if (motorCurrent()){//if motorCurrent is triggered then it will turn on the failure flag\n      failure = true;\n      Brain.Screen.clearScreen();\n      Brain.Screen.setCursor(1,1);\n      Brain.Screen.print(\"There's a jam, \");\n      Brain.Screen.newLine();\n      Brain.Screen.print(\"press the right button\");\n    }\n\n    allMotors.stop(brake);\n\n    Brain.Screen.clearScreen(); //User interface once page is done\n    Brain.Screen.setCursor(1,1);\n    Brain.Screen.print(\"Press right button to\");\n    Brain.Screen.newLine();\n    Brain.Screen.print(\"scan another or left\");\n    Brain.Screen.newLine();\n    Brain.Screen.print(\"button to finish.\");\n\n    numberOfTests++;\n\n    while (!Brain.buttonRight.pressing() && !Brain.buttonLeft.pressing())\n    {}//the right button is pressed to start another test\n  }\n\n  if (motorCurrent()){\n      failure = true;\n  }\n\n  allMotors.stop(brake);\n  return numberOfTests;\n\n  // test cases: left button or a jam should stop all motors and exit the loop\n  // pressing the LED starts/stops motors, right button restarts the scan loop\n}\n\n\n\n//The survey version of this function simply outputs the satistics of the survey\nvoid displayFinalGrade(bool &failure) {\n\n  int stats[TOTAL_ANSWERS] = {0};\n  int numTests = testInput(stats, failure);\n\n  printf(\"The statistics for the answer to each question over %d tests are as follows:\\n\", numTests);\n\n  for (int index = 0; index < QUESTIONS; index ++){\n    int aIndex = index*4, bIndex = (index*4)+1, cIndex = (index*4)+2, dIndex = (index*4)+3;\n\n    //print out all of the statistics for each question on the console\n    printf(\"Question %d\", index +1);\n    printf(\"%5c%5c%5c%5c\\n\", 'A', 'B', 'C', 'D');\n    printf(\"%10d%5d%5d%5d\\n\", stats[aIndex], stats[bIndex], stats[cIndex], stats[dIndex]);\n  }\n\n  Brain.Screen.clearScreen();\n  Brain.Screen.setCursor(1,1);\n  Brain.Screen.print(\"Statistics printed on console.\");\n\n}\n\n//Closes all files and shuts down all systems, we need to decide what we are putting in files and what failure is\nint shutDown(bool failure)\n{\n  Optical3.setLight(ledState::off);\n  Brain.programStop();\n  if (failure == false)\n  {\n    return EXIT_SUCCESS;\n  }\n  else\n  {\n    return EXIT_FAILURE; //only triggered by motorCurrent\n  }  \n}         \n\n\nint main()\n{\n  vexcodeInit();\n  timer timer1; //time of operation\n  bool failure = false;\n\n  Optical3.setLight(ledState::on);\n\n  displayFinalGrade(failure); //this runs the whole cycle\n\n  outputWheel(); //clear anything from tray\n  double time = timer1.time(seconds);\n     \n  if (!failure){\n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1,1);\n    Brain.Screen.print(\"Time elapsed: %.2f\", time);\n    Brain.Screen.newLine();\n    Brain.Screen.print(\"Press check button\");\n    Brain.Screen.newLine();\n    Brain.Screen.print(\"to end.\");\n  }\n  else{\n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1,1);\n    Brain.Screen.print(\"Sudden failure\");\n    Brain.Screen.newLine();\n    Brain.Screen.print(\"due to\");\n    Brain.Screen.newLine();\n    Brain.Screen.print(\"current overdrive.\");\n  }\n\n  while(!Brain.buttonCheck.pressing()) //wait for check button to be pressed for machine to turn off\n  {}\n\n  shutDown(failure);\n}","textLanguage":"cpp","robotConfig":[{"port":[1],"name":"leftMotor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[6],"name":"rightMotor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[12],"name":"Bumper12","customName":true,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22},{"port":[7],"name":"Distance7","customName":true,"deviceType":"Distance","deviceClass":"distance","setting":{},"triportSourcePort":22},{"port":[9],"name":"TouchLED9","customName":false,"deviceType":"TouchLED","deviceClass":"touchled","setting":{},"triportSourcePort":22},{"port":[3],"name":"Optical3","customName":false,"deviceType":"Optical","deviceClass":"optical","setting":{},"triportSourcePort":22},{"port":[4],"name":"backMotor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[5],"name":"pinionMotor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22}],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}