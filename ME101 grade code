    Brain.Screen.newLine();
    Brain.Screen.print("due to");
    Brain.Screen.newLine();
    Brain.Screen.print("current overdrive.");
  }

  while(!Brain.buttonCheck.pressing()) //wait for check button to be pressed for machine to turn off
  {}

  shutDown(failure);
}
