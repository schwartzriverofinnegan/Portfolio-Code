// Compares a students answers against the key and returns the number correct.
int gradeAnswer(const char answerWritten[], const char correctAnswer[], int questionCount) {
  int score = 0;
  for (int index = 0; index < questionCount; index++) {
    if (answerWritten[index] == correctAnswer[index]) {
      score++;
    }
    else{
      printf("Question %d wrong. Wrote %c should be %c\n", index + 1, answerWritten[index], correctAnswer[index]);
    }
  }
  return score;
}



// Function that sort of puts it all together, waits for LED and bumper pressed and then starts the 
// scanning and grading code using the previous functions
int testInput(int scores[], int info[2], bool &failure) {
  Brain.Screen.clearScreen(); //user interaction
  Brain.Screen.setFont(mono15);
  Brain.Screen.print("Input one test and");
  Brain.Screen.newLine();
  Brain.Screen.print("press LED");


  char studentAnswers[QUESTIONS];
  int numberOfTests = 0;
  char key[10] = {'B','A','D','C','B','D','C','C','C','B'}; // Hard-coded answer key
  int numberOfQs = 10;


  while (!Brain.buttonLeft.pressing() && !motorCurrent() && numberOfTests < MAX_STUDENTS) { //this loop is for every student/test
    backMotor.stop(brake);
    while (!Bumper12.pressing()) //Wait for tray to be placed
    {}
    TouchLED9.setColor(blue);
    while (!TouchLED9.pressing())  // wait for start press
    {}
    while (TouchLED9.pressing())   // wait for release
    {}
    TouchLED9.off(); //touch LED turns off after it's been tapped


    //answerKey(key); answer key program would go here if it were properly implemented

    Brain.Screen.clearScreen(); 
    Brain.Screen.setCursor(1,1);
    Brain.Screen.print("Processing test.");
    Brain.Screen.newLine();
    Brain.Screen.print("Press left button");
    Brain.Screen.newLine();
    Brain.Screen.print("for E-stop.");

   
    printf("Student %d ‘s answers\n", numberOfTests+1); //outputs wrong answers to the console
    wait(3,seconds);

   
    int index = 0;
    while (index < QUESTIONS && !Brain.buttonLeft.pressing() && !motorCurrent()) //this loop is for every row
    {
      if (Distance7.objectDistance(mm) > 2 && index > QUESTIONS-1) { //if the last question is scanned, this makes sure that it get out of the loop
        index += 20;
      }
      else if (index >= QUESTIONS-2){ //if its on the last question, use the back wheel to intake
        studentAnswers[index] = scanAnswers();


        printf("%c\n", studentAnswers[index]);
      
        index++;
        if (index <= 9) {
          walmartSpinForBack(10);
        }
        else {
          index++;
        }
     }


      else{ //else use the intake motors to intake
        intakeMotors.spin(forward, 7, percent);
        while (Optical3.color() != red && !Brain.buttonLeft.pressing() && !motorCurrent())
        {}
        // Leave the current red registration mark
        intakeMotors.stop(brake);


        studentAnswers[index] = scanAnswers();
        printf("%c\n", studentAnswers[index]); //outputs scanned letter to the console for testing/confirmation
       


        walmartSpinFor(10); //waits for the next red block
        index++;
      }     
    }


    if (motorCurrent()) { //if motorCurrent is triggered then it will turn on the failure flag
      failure = true;
      Brain.Screen.clearScreen();
      Brain.Screen.setCursor(1,1);
      Brain.Screen.print("There's a jam, ");
      Brain.Screen.newLine();
      Brain.Screen.print("press the right button");
    }

    allMotors.stop(brake);

    Brain.Screen.clearScreen(); // User interface once the page is done
    Brain.Screen.setCursor(1,1);
    Brain.Screen.print("Press right button");
    Brain.Screen.newLine();
    Brain.Screen.print("to scan another");
    Brain.Screen.newLine();
    Brain.Screen.print("or left button");
    Brain.Screen.newLine();
    Brain.Screen.print("to finish");

    int score = gradeAnswer(studentAnswers, key, numberOfQs);
    scores[numberOfTests] = (score * 100) / numberOfQs; //saves the scores of each student
    printf("This student's score was %d percent\n", scores[numberOfTests]);

    numberOfTests++;

    while (!Brain.buttonRight.pressing()&& !Brain.buttonLeft.pressing()) //the right button is pressed to start another test
    {}
    backMotor.spin(forward,20,percent); //gets rid of anything left in the scanner
  }

  if (motorCurrent()) {
    failure = true;
    Brain.Screen.clearScreen();
    Brain.Screen.setCursor(1,1);
    Brain.Screen.print("There's a jam");
  }


  allMotors.stop(brake);
  return numberOfTests;


  // test cases: left button or a jam should stop all motors and exit the loop
  // pressing the LED starts/stops motors, right button restarts the scan loop
}


//intakes the number of questions in a test and the number of correct answers from a student and calculates the grade
//This will be put into a loop to create an array of students grades.
void displayFinalGrade(bool &failure) {
  int scores[MAX_STUDENTS] = {0};
  int info[2] = {0, 0};

  int numTests = testInput(scores, info, failure);
  int totalPercent = 0;

  for (int index = 0; index < numTests; index++)
    totalPercent += scores[index];

  float averageScore = (float)totalPercent / numTests;

  Brain.Screen.clearScreen();
  Brain.Screen.setCursor(1,1);
  printf("The average grade of the class was is %.2f %%\n", averageScore);
}


//Closes all files and shuts down all systems, we need to decide what we are putting in files and what failure is
int shutDown(bool failure)
{
  Optical3.setLight(ledState::off); 
  Brain.programStop();
  if (failure == false) 
  {
    return EXIT_SUCCESS;
  }
  else
  {
    return EXIT_FAILURE; //only triggered by motorCurrent
  }  
}        


