// Function that sort of puts it all together, waits for LED and bumper pressed and then starts the
// scanning and grading code using the previous functions
int testInput(int stats[], bool &failure) {
  Brain.Screen.clearScreen(); //user interaction
  Brain.Screen.setFont(mono15);
  Brain.Screen.print("Input one test");
  Brain.Screen.newLine();
  Brain.Screen.print("and press LED"); 

  int numberOfTests = 0;
  int tempIndex = 0;

  while (!Brain.buttonLeft.pressing() && !motorCurrent() && numberOfTests < MAX_STUDENTS) { //this loops for every test
    backMotor.stop(brake);
    while (!Bumper12.pressing()) //wait for tray to be placed
    {}
    TouchLED9.setColor(blue);
    while (!TouchLED9.pressing())  // wait for start press
    {}
    while (TouchLED9.pressing())   // wait for release
    {}
    TouchLED9.off(); //touchLED turns off after tapped
    printf("Processing student %d\n", numberOfTests+1);

    Brain.Screen.clearScreen();
    Brain.Screen.setCursor(1,1);
    Brain.Screen.print("Processing test.");
    Brain.Screen.newLine();
    Brain.Screen.print("Press left button");
    Brain.Screen.newLine();
    Brain.Screen.print("for E-stop.");


    int index = 0;
    while (index < QUESTIONS && !Brain.buttonLeft.pressing() && !motorCurrent()) //this loops for every row
    {
      if (Distance7.objectDistance(mm) > PAGE_DIST && index > QUESTIONS-1) { //if the last question is scanned, this makes sure that it get out of the loop
        index += 20;
      }
      else if (index >= QUESTIONS-2) { //if its on the last question, use the back wheel to intake
        char letter = scanAnswers(); 

        //every four spots in the array represent one question
        if (letter == 'A')
          tempIndex = index * 4; //the first spot is the letter A

        else if (letter == 'B')
          tempIndex = (index * 4) +1; //The second the letter B

        else if (letter == 'C')
          tempIndex = (index*4)+2; //and so on
        
        else
          tempIndex = (index*4) + 3; //and so on
        
        stats[tempIndex] +=1; //add a count to that place in the array

        index++;
      }
      else{ //else use the intake motors to intake
        intakeMotors.spin(forward,7,percent);
        while (Optical3.color() != red && !Brain.buttonLeft.pressing())
        {}
        intakeMotors.stop(brake);

        char letter = scanAnswers(); 

        if (letter == 'A')
          tempIndex = index * 4;

        else if (letter == 'B')
          tempIndex = (index * 4)+1;

        else if (letter == 'C')
          tempIndex = (index*4) + 2;
          
        else
          tempIndex = (index*4) + 3;
          
        stats[tempIndex]++;

        walmartSpinFor(10); //waits for next red block
        index++;
      }
    }

    if (motorCurrent()){//if motorCurrent is triggered then it will turn on the failure flag
      failure = true;
      Brain.Screen.clearScreen();
      Brain.Screen.setCursor(1,1);
      Brain.Screen.print("There's a jam, ");
      Brain.Screen.newLine();
      Brain.Screen.print("press the right button");
    }

    allMotors.stop(brake);

    Brain.Screen.clearScreen(); //User interface once page is done
    Brain.Screen.setCursor(1,1);
    Brain.Screen.print("Press right button to");
    Brain.Screen.newLine();
    Brain.Screen.print("scan another or left");
    Brain.Screen.newLine();
    Brain.Screen.print("button to finish.");

    numberOfTests++;

    while (!Brain.buttonRight.pressing() && !Brain.buttonLeft.pressing())
    {}//the right button is pressed to start another test
  }

  if (motorCurrent()){
      failure = true;
  }

  allMotors.stop(brake);
  return numberOfTests;

  // test cases: left button or a jam should stop all motors and exit the loop
  // pressing the LED starts/stops motors, right button restarts the scan loop
}



//The survey version of this function simply outputs the satistics of the survey
void displayFinalGrade(bool &failure) {

  int stats[TOTAL_ANSWERS] = {0};
  int numTests = testInput(stats, failure);

  printf("The statistics for the answer to each question over %d tests are as follows:\n", numTests);

  for (int index = 0; index < QUESTIONS; index ++){
    int aIndex = index*4, bIndex = (index*4)+1, cIndex = (index*4)+2, dIndex = (index*4)+3;

    //print out all of the statistics for each question on the console
    printf("Question %d", index +1);
    printf("%5c%5c%5c%5c\n", 'A', 'B', 'C', 'D');
    printf("%10d%5d%5d%5d\n", stats[aIndex], stats[bIndex], stats[cIndex], stats[dIndex]);
  }

  Brain.Screen.clearScreen();
  Brain.Screen.setCursor(1,1);
  Brain.Screen.print("Statistics printed on console.");

}

//Closes all files and shuts down all systems, we need to decide what we are putting in files and what failure is
int shutDown(bool failure)
{
  Optical3.setLight(ledState::off);
  Brain.programStop();
  if (failure == false)
  {
    return EXIT_SUCCESS;
  }
  else
  {
    return EXIT_FAILURE; //only triggered by motorCurrent
  }  
}         


