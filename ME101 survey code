const int PAGE_DIST = 1; // mm, distance to paper from sensor
const int QUESTIONS = 10; // max questions per test
const int MAX_STUDENTS = 10; // max students per grading run
const double PINION_DIAMETER = 20.0; // mm, rack-and-pinion diameter - verify this
const int TOTAL_ANSWERS = QUESTIONS * 5;
const int MAX_DIST = 125; //mm, max distance the pinion can travel


motor_group intakeMotors(leftMotor, rightMotor);
motor_group allMotors(leftMotor, rightMotor, backMotor); //useful for when all motors need to turn off


// Returns true if any drive motor is drawing more current than expected
bool motorCurrent() {
  if (leftMotor.current(amp) > 1 || rightMotor.current(amp) > 1 ||
      backMotor.current(amp) > 1) {
    return true;
  } else {
    return false;
  }
  // test cases: run the motor for a few minutes and check for auto-stop/heat
  // jam the wheels and confirm this returns true
}


// Checks the distance sensor and spins the back (eject) wheel while a sheet is detected in front of it.
void outputWheel() {
  backMotor.spin(forward, 50, percent); 
  while (Distance7.objectDistance(mm) < PAGE_DIST && !motorCurrent())
  {}
  backMotor.stop(brake);
  // test cases: paper on sensor -> motor off, paper off sensor -> motor on
}


// A substitute "spin for" function that waits to see the next red block, stopped by the left button
void walmartSpinFor(double distance)
{
  intakeMotors.spin(forward,10,percent);
  while (Optical3.color() == red && !Brain.buttonLeft.pressing() && !motorCurrent());
  {}
  while(Optical3.color() != red && !Brain.buttonLeft.pressing() && !motorCurrent())
  {}
  intakeMotors.stop(brake);
}


// Same as the previous function except it's for the back motor,
//this is used for the last question on the sheet since the intake motors can't reach the paper anymore
void walmartSpinForBack(double distance)
{
  backMotor.spin(forward,20,percent); //speed is higher than for intake because back wheel doesn't grip paper very well
  while (Optical3.color() == red && !Brain.buttonLeft.pressing() && !motorCurrent())
  {}
  while(Optical3.color() != red && !Brain.buttonLeft.pressing() && !motorCurrent())
  {}
  backMotor.stop(brake);
}


// intakes paper to red square and then moves rack and pinion; reads the rack travel distance and converts it into a lettered answer (A-D)
char scanAnswers()
{
  pinionMotor.resetPosition(); //this is done so the pinion can be moved back to the exact origin after it's done scanning
  pinionMotor.spin(forward, 15, percent);

  while (Optical3.color() != green && (pinionMotor.position(degrees) / 360) * M_PI * PINION_DIAMETER < MAX_DIST && !Brain.buttonLeft.pressing() && !motorCurrent())
  {} //wait until sensor sees green or the pinion has gone the max distance

  pinionMotor.stop(brake);


    double motorDegrees = pinionMotor.position(degrees);
    double rackDistance = (motorDegrees / 360.0) * M_PI * PINION_DIAMETER;

    char answer;

    if (rackDistance < 50) // mm; hard-coded distances for each of the bubbles
        answer = 'A';
  
    else if (rackDistance < 80)
        answer = 'B';
        
    else if (rackDistance < 115)
        answer = 'C';
        
    else
        answer = 'D';
        

    // Return the pinion to the starting position
    pinionMotor.spin(reverse, 10, percent);

    while (pinionMotor.position(degrees) > 2 && !Brain.buttonLeft.pressing() && !motorCurrent()) //tolerance because i dont want it to overshoot to 0
    {
    }

    pinionMotor.stop(brake);

    return answer;
}


